# Copiar a /etc/systemd/system/ (lo hace install.sh). Lo arranca paperscraper-daily.timer.
[Unit]
Description=Revisión diaria de los autores seguidos de paperScraper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jorge
WorkingDirectory=/home/jorge/paperScraper
Environment=LANG=C.UTF-8 PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
# Chrome (Sci-Hub) se abre en la pantalla de la torre, la sesión que deja abierta el autologin.
Environment=DISPLAY=:0 XAUTHORITY=/home/jorge/.Xauthority
ExecStart=/home/jorge/paperScraper/.venv/bin/python daily_check.py
# Con muchos autores y Sci-Hub puede tardar; más de 8 horas sería que algo se ha quedado colgado.
TimeoutStartSec=8h
