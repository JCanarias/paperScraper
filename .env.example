OPENALEX_API_URL=https://api.openalex.org
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
UNPAYWALL_API_URL=https://api.unpaywall.org/v2
UNPAYWALL_EMAIL=tu@correo.com
CORE_API_URL=https://api.core.ac.uk/v3
CORE_API_KEY=
CUSTOM_LEGAL_SOURCE_API_URL=https://your-api-url-here.com
INTERNET_ARCHIVE_URL=https://archive.org
GUTENDEX_API_URL=https://gutendex.com
# Free at https://openalex.org/settings/api ; needed to get more than 200 works.
OPEN_ALEX_API_KEY=
# Free at https://pro.europeana.eu/page/apis ; access to European digital libraries.
EUROPEANA_API_KEY=
# Your Calibre content server, to skip the books you already have and upload the new ones.
# The user must not be read-only to upload. CALIBRE_LIBRARY is optional (the default library).
CALIBRE_URL=
CALIBRE_USERNAME=
CALIBRE_PASSWORD=
CALIBRE_LIBRARY=
# Where your browser saves downloads (for "descargar a mano"); by default ~/Downloads.
DOWNLOADS_FOLDER=
