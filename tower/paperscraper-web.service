# Copiar a /etc/systemd/system/paperscraper-web.service (lo hace install.sh).
[Unit]
Description=Menú de paperScraper como terminal en el navegador
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jorge
WorkingDirectory=/home/jorge/paperScraper
Environment=LANG=C.UTF-8
ExecStart=/home/jorge/paperScraper/tower/start.sh
Restart=on-failure
RestartSec=10
# Al reiniciar el servicio solo se para ttyd: tmux, con la búsqueda que esté en marcha, sigue.
KillMode=process

[Install]
WantedBy=multi-user.target
