# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Carpeta donde se guardan los archivos recibidos
TELEGRAM_DOWNLOAD_DIR=/home/jorge/Descargas/telegram
# Ids de usuario autorizados, separados por comas (mándale /start al bot para ver el tuyo)
TELEGRAM_ALLOWED_USER_IDS=
# Opcional: servidor Bot API local para archivos de más de 20 MB (p. ej. http://localhost:8081)
TELEGRAM_LOCAL_API_URL=
# Opcional: extensiones admitidas, separadas por comas (por defecto: pdf, epub, mobi, azw3, txt, docx...)
TELEGRAM_ALLOWED_EXTENSIONS=
